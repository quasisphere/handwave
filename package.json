{
  "name": "handwave",
  "displayName": "Handwave",
  "description": "Browse and preview Handwave articles linked to Lean declarations.",
  "version": "0.0.1",
  "publisher": "handwave",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:handwave.rebuildIndex",
    "onCommand:handwave.openArticlePreview",
    "onCommand:handwave.showBacklinks"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "handwave.rebuildIndex",
        "title": "Handwave: Rebuild Index"
      },
      {
        "command": "handwave.openArticlePreview",
        "title": "Handwave: Open Preview"
      },
      {
        "command": "handwave.previewBack",
        "title": "Handwave: Back",
        "icon": "$(arrow-left)",
        "enablement": "handwave.previewCanGoBack"
      },
      {
        "command": "handwave.previewForward",
        "title": "Handwave: Forward",
        "icon": "$(arrow-right)",
        "enablement": "handwave.previewCanGoForward"
      },
      {
        "command": "handwave.showBacklinks",
        "title": "Handwave: Show Backlinks"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "handwave.previewBack",
          "when": "activeWebviewPanelId == 'handwave.articlePreview'",
          "group": "navigation@1"
        },
        {
          "command": "handwave.previewForward",
          "when": "activeWebviewPanelId == 'handwave.articlePreview'",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Handwave",
      "properties": {
        "handwave.articleGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.hw.md",
            "**/*.hw"
          ],
          "description": "Glob patterns for Handwave article files."
        },
        "handwave.leanGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.lean"
          ],
          "description": "Glob patterns for Lean files indexed by Handwave."
        },
        "handwave.excludeGlob": {
          "type": "string",
          "default": "**/{node_modules,out,.git,.jj,.lake}/**",
          "description": "Glob pattern excluded when Handwave indexes articles and Lean files."
        },
        "handwave.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable diagnostics for unresolved Handwave links, includes, and malformed doc blocks."
        },
        "handwave.enableLeanDependencyChecks": {
          "type": "boolean",
          "default": true,
          "description": "Use Lean axiom probes to decide whether theorem dependencies transitively depend on sorryAx. When disabled, Handwave only uses Lean LSP diagnostics for theorem badges."
        },
        "handwave.leanDependencyCheckDelayMs": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "description": "Delay before running Lean dependency checks after a theorem has clean Lean LSP diagnostics."
        },
        "handwave.leanDependencyCheckTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "description": "Timeout for each Handwave Lean dependency-check process."
        }
      }
    },
    "languages": [
      {
        "id": "handwave-article",
        "aliases": [
          "Handwave Article",
          "handwave"
        ],
        "extensions": [
          ".hw",
          ".hw.md"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.2"
  }
}
